# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# MongoDB connection string. REQUIRED — nothing works without it.
# Atlas: Connect → Drivers → Node.js, then REPLACE <db_password> (angle brackets
# and all) with your database user's password. Leaving it in is mistake number
# one, and the error it causes points nowhere near the cause.
# Local mongod: mongodb://localhost:27017
#
# Never used MongoDB before? docs/database.md goes from nothing to connected.
# Check it with:  npm run check
MONGODB_URI=mongodb+srv://dbUser:<db_password>@cluster0.ab1cd.mongodb.net/

# Optional: override the database name (default: maths-tutor)
# MONGODB_DB=maths-tutor

# Optional: override the port the Express server listens on (default: 3000)
# PORT=3000

# ── API keys — REQUIRED. The API refuses every request without both. ─────────
# (Local `node server.js` skips the check by default; set TUTOR_AUTH=on to test it. Prod always enforces it.)
# Two tiers, because the child's iPad stores its key permanently:
#   TUTOR_CHILD_KEY  the child's page. Reaches only GET /api/sessions/next and
#                    POST /api/sessions/:id/{attempts,finish}.
#   TUTOR_ADMIN_KEY  everything, including the dashboard, curriculum edits and
#                    session deletes. Never put this one on the child's device.
#
# Generate a fresh pair with:
#   node -e "const c=require('crypto');for(const k of ['TUTOR_CHILD_KEY','TUTOR_ADMIN_KEY'])console.log(k+'='+c.randomBytes(24).toString('base64url'))"
#
# Set the same two values in Netlify → Site settings → Environment variables.
TUTOR_CHILD_KEY=
TUTOR_ADMIN_KEY=

# The child's time zone, for what counts as "today" (the streak, the week strip).
# Netlify runs in UTC, so set this there. Locally it defaults to this machine's zone.
# TUTOR_TZ=Europe/London
